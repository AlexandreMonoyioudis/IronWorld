type: tank
name: skimmer
localizedName: Skimmer
description: A boost-capable tank unit armed with a rotating coilgun.

health: 200
speed: 1.2
accel: 0.08
drag: 0.01
canBoost: true
boostMultiplier: 1.5
treadEffect: unitDust
rotateShooting: false
omniMovement: false
rotateMoveFirst: true
range: 76
tankMoveSound: tankMoveSmall
tankMoveVolume: 0.2

weapons: [
    {
        name: small-coilgun
        x: 0
        y: 2
        mirror: false
        rotate: true
        autoTarget: true
        reload: 40
        cooldownTime: 60
        shootSound: shoot
        bullet: {
            type: BasicBulletType
            speed: 4
            damage: 25
            lifetime: 19
            hitSound: explosion
            hitSoundVolume: 0.2
            frontColor: b0b0b0
            backColor: 666666
        }
    }
]
