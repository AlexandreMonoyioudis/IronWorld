        mirror: false
        rotate: true
        autoTarget: true
        reload: 30
        bullet: {
            type: BasicBulletType
            speed: 4
            damage: 25
            lifetime: 60
            frontColor: b0b0b0
            backColor: 666666
        }
    }
]
